<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PackageId>Eddy.x12.DomainModels.CommunicationsAndControls</PackageId>
    <Version>0.0.1-beta</Version>
    <Title>EDDY EDI x12 Communications And Controls Models</Title>
    <Authors>GotWoods</Authors>
    <Description>
      Read and Generate X12 Communications And Controls models (e.g. 864, 997, etc.)
    </Description>
    <PackageTags>EDI;x12</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Configurations>Debug;Release;local</Configurations>
  </PropertyGroup>

  <!--
    Debug and local builds compile against the sibling projects so the models are checked against the
    current parser sources. Release is what the publish workflow packs with, after it repoints the
    package versions, so Release uses the package references. Same pattern as Eddy.x12 and Eddy.Edifact.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <ProjectReference Include="..\Eddy.Core\Eddy.Core.csproj" />
    <ProjectReference Include="..\Eddy.x12\Eddy.x12.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Eddy.Core" Version="0.0.8-beta" />
    <PackageReference Include="Eddy.x12Parser" Version="0.0.6-beta" />
  </ItemGroup>

</Project>



