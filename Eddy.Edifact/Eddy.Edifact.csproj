<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFramework>netstandard2.0</TargetFramework>
	  <LangVersion>latest</LangVersion>
	  <Configurations>Debug;Release;local</Configurations>
	  <Title>EDDY Edifact Parser</Title>
	  <Authors>GotWoods</Authors>
	  <Version>0.0.6-beta</Version>
	  <Description>Parser for the Edifact standard into POCO objects</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Eddy.Edifact.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Debug and local builds compile against the sibling Eddy.Core project so new Core APIs are available
    immediately. Release is what the publish workflow packs with, after it repoints the Eddy.Core package
    version to the one it just published, so Release uses the package reference. Same pattern as Eddy.x12.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <ProjectReference Include="..\Eddy.Core\Eddy.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Eddy.Core" Version="0.0.9-beta" />
  </ItemGroup>

</Project>
